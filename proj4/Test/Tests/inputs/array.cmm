int calculateBase(int inputParam) {
    int baseRes;
    if (inputParam > 50) {
        baseRes = inputParam / 2;
        return baseRes;
    } else {
        baseRes = inputParam + 10;
        return baseRes;
    }
}

int determineIndex(int baseIn, int inputOther) {
    int indexRes = (baseIn + inputOther) / 5;
    if (indexRes < 0) { return 0; }
    if (indexRes > 4) { return 4; }
    return indexRes;
}

