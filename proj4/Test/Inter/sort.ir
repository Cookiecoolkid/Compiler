
FUNCTION calculateInnerLoopLimit :
PARAM totalSize_
PARAM outerLoopIndex_
temp0 := totalSize_ - outerLoopIndex_
temp1 := temp0 - #1
limitResult_ := temp1
RETURN limitResult_

FUNCTION main :
