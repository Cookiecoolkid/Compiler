temp66 := &sortArrayData_
temp67 := #4 * #4
temp68 := temp67 + temp66
temp69 := *temp68
WRITE temp69
temp70 := outerIdx_ + #1
outerIdx_ := temp70
GOTO label3
LABEL label5 :
