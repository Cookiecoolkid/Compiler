FUNCTION main :
READ v1
READ v3
v22 := v1 + #1
v6 := v22
v8 := v9
v27 := v22 - v1
v15 := v27
LABEL L1 :
v2 := v15
v28 := v15 * v8
v4 := v28
IF v6 <= v8 GOTO L3
LABEL L2 :
v6 := #4
v29 := v2 * #5
v8 := v29
GOTO L4
LABEL L3 :
LABEL L4 :
IF v2 > v4 GOTO L1
LABEL L5 :
v31 := #2 * v8
WRITE v31
RETURN #0

